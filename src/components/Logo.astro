---
// HoangBeard badge: a T-rex head ("Rex") whose lower jaw becomes a beard, inside a hexagon shield.
---

<span class="logo">
  <svg viewBox="0 0 100 100" aria-hidden="true">
    <path fill="var(--surface)" stroke="var(--gold)" stroke-width="4" stroke-linejoin="round" d="M50 4 L90 27 L90 73 L50 96 L10 73 L10 27 Z"/>
  <g transform="translate(13 10) scale(0.74)"><g fill="var(--gold)"><path d="M12 60 L14 44 L24 30 L40 24 L54 22 L60 26 L84 28 L93 33 L94 45 L88 45 L86 49 L82 45 L78 49 L74 45 L70 49 L66 45 L56 47 L48 52 L34 56 Z"/><path d="M44 58 L54 52 L64 51 L68 55 L72 51 L76 55 L80 51 L86 52 L84 60 L78 64 L76 72 L70 70 L66 82 L61 76 L58 92 L54 78 L50 80 L48 70 L42 70 L36 66 L24 66 Z"/></g><path fill="var(--surface)" d="M49 31 L64 30 L62 33 L57 36 L51 35 Z"/><path fill="var(--surface)" d="M85 33 L89 33 L88 36 Z"/></g>
  </svg>
  <span class="wordmark">Hoang<span>Beard</span></span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  svg { width: 36px; height: 36px; flex: none; filter: drop-shadow(0 0 6px rgba(212, 175, 55, 0.35)); transition: filter 200ms; }
  .wordmark { font: 800 1.1rem var(--font-display); letter-spacing: -0.02em; color: var(--fg); }
  .wordmark span { color: var(--gold); text-shadow: 0 0 12px rgba(212, 175, 55, 0.45); }
  :global(a:hover) > .logo svg { filter: drop-shadow(0 0 10px rgba(212, 175, 55, 0.7)); }
</style>
