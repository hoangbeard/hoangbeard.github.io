<ul class="social">
  {links.map(link => (
    <li>
      <a href={link.href} aria-label={link.label} title={link.label}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={link.icon} /></svg>
        <span>{link.label}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .social { display: flex; gap: 8px; list-style: none; flex-wrap: wrap; }
  a {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 6px 11px; border-radius: 8px;
    border: 1px solid var(--border); background: rgba(255, 255, 255, 0.02);
    color: var(--fg-2); font-size: 0.84rem;
    transition: all 180ms var(--ease);
  }
  svg { width: 15px; height: 15px; fill: currentColor; transition: filter 180ms; }
  a:hover { color: var(--gold-bright); border-color: rgba(212, 175, 55, 0.5); box-shadow: 0 0 16px -4px rgba(212, 175, 55, 0.55); text-shadow: none; text-decoration: none; }
  a:hover svg { filter: drop-shadow(0 0 5px rgba(212, 175, 55, 0.8)); }
</style>
