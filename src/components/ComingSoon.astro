---
interface Props { text?: string }
const { text = 'Coming soon' } = Astro.props
---

<span class="soon">{text}</span>

<style>
  .soon { font: 600 0.68rem var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--fg-2); border: 1px dashed rgba(212, 175, 55, 0.3); background: rgba(212, 175, 55, 0.04); border-radius: 3px; padding: 3px 7px; white-space: nowrap; }
</style>
